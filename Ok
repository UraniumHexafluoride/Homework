\section{Detailed Numerical Worked Example}

\begin{mdframed}[style=examplebox]
\noindent {\color{bookblue} \textbf{Example 12.1: 3D Coordinate Calculation for a Two-Node Array Segment}} \\[0.5em]
\textbf{Problem Statement:} \\
A towed acoustic array has its cable nose ($s = 0\text{ m}$) located at geographic position:
$$x_0 = 100.000\text{ m (East)}, \quad y_0 = 200.000\text{ m (North)}, \quad z_0 = 15.000\text{ m (Depth)}$$

Two NAS nodes are positioned along the array segment at arc lengths $s_1 = 0.0\text{ m}$ and $s_2 = 10.0\text{ m}$ ($\Delta s = 10.0\text{ m}$). The sensor field data provides the following readings:
\begin{itemize}[itemsep=2pt]
    \item \textbf{Node 1 ($s_1 = 0\text{ m}$):} Heading $\psi_1 = 90.0^\circ$ ($1.57080\text{ rad}$), Pitch $\theta_1 = +2.0^\circ$ ($0.03491\text{ rad}$)
    \item \textbf{Node 2 ($s_2 = 10\text{ m}$):} Heading $\psi_2 = 102.0^\circ$ ($1.78024\text{ rad}$), Pitch $\theta_2 = +4.0^\circ$ ($0.06981\text{ rad}$)
    \item \textbf{Pressure at Node 2 ($s_2 = 10\text{ m}$):} $P_2 = 257,511\text{ Pa}$
\end{itemize}
Compute the exact 3D coordinates $(x, y, z)$ at $s = 10.0\text{ m}$ using midpoint integration and hydrostatic depth pinning.
\\[0.8em]
\textbf{Solution Step-by-Step:}

\noindent \textbf{Step 1: Compute Midpoint Angles}
$$\bar{\psi} = \frac{90.0^\circ + 102.0^\circ}{2} = 96.0^\circ \quad \longrightarrow \quad 1.67552\text{ rad}$$
$$\bar{\theta} = \frac{2.0^\circ + 4.0^\circ}{2} = 3.0^\circ \quad \longrightarrow \quad 0.05236\text{ rad}$$

\noindent \textbf{Step 2: Evaluate Trigonometric Terms}
$$\cos(\bar{\theta}) = \cos(0.05236) = 0.99863, \qquad \sin(\bar{\theta}) = \sin(0.05236) = 0.05234$$
$$\sin(\bar{\psi}) = \sin(1.67552) = 0.99452, \qquad \cos(\bar{\psi}) = \cos(1.67552) = -0.10453$$

\noindent \textbf{Step 3: Compute Spatial Increments ($\Delta s = 10.0\text{ m}$)}
$$\Delta x = -\Delta s \cdot \cos(\bar{\theta}) \sin(\bar{\psi}) = -10.0 \times 0.99863 \times 0.99452 = -9.9316\text{ m}$$
$$\Delta y = -\Delta s \cdot \cos(\bar{\theta}) \cos(\bar{\psi}) = -10.0 \times 0.99863 \times (-0.10453) = +1.0439\text{ m}$$
$$\Delta z_{\text{int}} = +\Delta s \cdot \sin(\bar{\theta}) = +10.0 \times 0.05234 = +0.5234\text{ m}$$

\noindent \textbf{Step 4: Calculate Raw Unpinned Position at $s = 10.0\text{ m}$}
$$x(10) = x_0 + \Delta x = 100.000 - 9.9316 = \mathbf{90.0684\text{ m}}$$
$$y(10) = y_0 + \Delta y = 200.000 + 1.0439 = \mathbf{201.0439\text{ m}}$$
$$z_{\text{int}}(10) = z_0 + \Delta z_{\text{int}} = 15.000 + 0.5234 = \mathbf{15.5234\text{ m}}$$

\noindent \textbf{Step 5: Hydrostatic Pressure Pinning} \\
Convert node 2 pressure measurement $P_2 = 257,511\text{ Pa}$ to measured physical depth:
$$z_{\text{meas}}(10) = \frac{257,511 - 101,325}{1025 \times 9.81} = \frac{156,186}{10,055.25} = 15.5328\text{ m}$$

Evaluate residual error $r_2$ at node 2:
$$r_2 = z_{\text{meas}}(10) - z_{\text{int}}(10) = 15.5328 - 15.5234 = +0.0094\text{ m}$$

Adding the correction residual yields the final pinned depth:
$$z_{\text{final}}(10) = z_{\text{int}}(10) + r_2 = 15.5234 + 0.0094 = \mathbf{15.5328\text{ m}}$$
\end{mdframed}

